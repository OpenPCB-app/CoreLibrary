{
  "name": "@openpcb-corelib/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"bun --watch server/main.ts\" \"vite\"",
    "dev:server": "bun --watch server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "bun server/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openpcb/core-import": "workspace:*",
    "@openpcb/kicad-parsers": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/drei": "^10.0.0",
    "three": "^0.170.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "occt-import-js": "^0.0.22"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "typescript": "~5.8.3",
    "concurrently": "^9.0.0"
  }
}
