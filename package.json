{
  "name": "openpcb-core-library",
  "version": "1.0.0",
  "description": "OpenPCB Core Library — readable JSON source for the default component library.",
  "license": "SEE LICENSE.md",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "validate": "bun tools/validate.ts",
    "pack": "bun tools/pack.ts",
    "typecheck": "bun --bun tsc --noEmit --project tsconfig.json",
    "test": "bun test",
    "admin": "bun --filter @openpcb-corelib/admin run dev"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "~5.8.3"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
