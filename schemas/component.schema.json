{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpcb.app/schemas/component.schema.json",
  "title": "OpenPCB Library Component",
  "type": "object",
  "required": [
    "id",
    "uuid",
    "version",
    "name",
    "symbol",
    "defaultFootprint",
    "footprints",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "version": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "category": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "symbol": { "type": "string" },
    "defaultFootprint": { "type": "string" },
    "footprints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["footprint", "label"],
        "additionalProperties": false,
        "properties": {
          "footprint": { "type": "string" },
          "label": { "type": "string" },
          "pinMap": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["pinNumber", "padNumber"],
              "properties": {
                "pinNumber": { "type": "string" },
                "padNumber": { "type": "string" },
                "pinName": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "subcategory": { "type": "string" },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "datasheet": { "type": ["string", "null"], "format": "uri" },
    "datasheetSource": { "type": "string", "format": "uri" },
    "parameters": { "type": "object" },
    "manufacturerParts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["manufacturer", "mpn"],
        "additionalProperties": false,
        "properties": {
          "manufacturer": { "type": "string" },
          "mpn": { "type": "string" },
          "lcsc": { "type": "string", "pattern": "^C[0-9]+$" },
          "jlcpcbAssemblyType": {
            "type": "string",
            "enum": ["basic", "preferred", "extended"]
          },
          "package": { "type": "string" },
          "role": { "type": "string", "enum": ["primary", "alternate"] },
          "datasheet": { "type": "string", "format": "uri" }
        }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "compatibility": {
      "type": "object",
      "properties": {
        "minOpenPcbVersion": { "type": "string" }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "license",
        "attribution",
        "sourceFormat",
        "sourceFileName",
        "sourceLibrary",
        "sourceItemName",
        "sourceHash",
        "upstreamUrl",
        "convertedAt",
        "conversionTool"
      ],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "license": { "type": "string" },
        "attribution": { "type": "array", "items": { "type": "string" } },
        "sourceFormat": { "type": "string" },
        "sourceFileName": { "type": "string" },
        "sourceLibrary": { "type": "string" },
        "sourceItemName": { "type": "string" },
        "sourceHash": { "type": "string" },
        "upstreamUrl": { "type": "string" },
        "upstreamCommit": { "type": "string" },
        "convertedAt": { "type": "string", "format": "date-time" },
        "conversionTool": { "type": "string" }
      }
    }
  }
}
