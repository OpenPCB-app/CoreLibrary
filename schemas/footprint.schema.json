{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpcb.app/schemas/footprint.schema.json",
  "title": "OpenPCB Library Footprint (source file)",
  "description": "Source file for a single library footprint. Top-level identity fields are mandatory; provenance/normalized/preview/raw are preserved verbatim and become dataJson on import.",
  "type": "object",
  "required": ["id", "uuid", "version", "name", "provenance"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "version": { "type": "string" },
    "name": { "type": "string" },
    "mountType": {
      "type": "string",
      "enum": ["smd", "tht", "through_hole", "press_fit", "mixed"]
    },
    "package": { "type": "object" },
    "models3d": { "type": "array", "items": { "type": "string" } },
    "no3d": {
      "type": "boolean",
      "description": "Footprint legitimately ships without a 3D model (mechanical-only parts, or asm-only electrical parts lacking an upstream STEP). Exempts it from the release STEP gate."
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "parser": { "type": "object" },
    "normalized": { "type": "object" },
    "raw": { "type": "object" }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "license",
        "attribution",
        "sourceFormat",
        "sourceFileName",
        "sourceLibrary",
        "sourceItemName",
        "sourceHash",
        "upstreamUrl",
        "convertedAt",
        "conversionTool"
      ],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "license": { "type": "string" },
        "attribution": { "type": "array", "items": { "type": "string" } },
        "sourceFormat": { "type": "string" },
        "sourceFileName": { "type": "string" },
        "sourceLibrary": { "type": "string" },
        "sourceItemName": { "type": "string" },
        "sourceHash": { "type": "string" },
        "upstreamUrl": { "type": "string" },
        "upstreamCommit": { "type": "string" },
        "convertedAt": { "type": "string", "format": "date-time" },
        "conversionTool": { "type": "string" }
      }
    }
  }
}
