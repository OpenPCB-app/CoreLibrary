{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpcb.app/schemas/symbol.schema.json",
  "title": "OpenPCB Library Symbol (source file)",
  "description": "Source file for a single library symbol. Top-level identity fields are mandatory; the rest of the document (provenance, normalized, preview, raw) is preserved verbatim and stored as dataJson on import.",
  "type": "object",
  "required": ["id", "uuid", "version", "name", "provenance"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "version": { "type": "string" },
    "name": { "type": "string" },
    "referencePrefix": { "type": "string" },
    "description": { "type": "string" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "parser": { "type": "object" },
    "normalized": { "type": "object" },
    "raw": { "type": "object" }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "license",
        "attribution",
        "sourceFormat",
        "sourceFileName",
        "sourceLibrary",
        "sourceItemName",
        "sourceHash",
        "upstreamUrl",
        "convertedAt",
        "conversionTool"
      ],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "license": { "type": "string" },
        "attribution": { "type": "array", "items": { "type": "string" } },
        "sourceFormat": { "type": "string" },
        "sourceFileName": { "type": "string" },
        "sourceLibrary": { "type": "string" },
        "sourceItemName": { "type": "string" },
        "sourceHash": { "type": "string" },
        "upstreamUrl": { "type": "string" },
        "upstreamCommit": { "type": "string" },
        "convertedAt": { "type": "string", "format": "date-time" },
        "conversionTool": { "type": "string" }
      }
    }
  }
}
